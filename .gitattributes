# .gitattributes (repo root)

# Auto-detect text files; normalize to LF in the repo
* text=auto

# Shell scripts and Unix-y files: always LF
*.sh            text eol=lf
mvnw            text eol=lf
*.java          text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Windows scripts: always CRLF
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary files — never touch
*.jar           binary
*.png           binary
*.jpg           binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
