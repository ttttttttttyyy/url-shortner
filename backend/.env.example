# =============================================================================
# Shortly - environment template
#
# Reference template: export these variables or set them in the VPS service
# unit. Spring Boot does not read .env automatically.
# Never commit real secrets; .env is ignored by git.
# =============================================================================

# --- Core ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=10004
APP_BASE_URL=https://short.example.com
APP_VERSION=0.0.1

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://127.0.0.1:5432/shortly?ApplicationName=shortly&reWriteBatchedInserts=true
DB_USERNAME=shortly
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# --- Security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=shortly
JWT_AUDIENCE=shortly-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=https://short.example.com

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_GUEST_CREATE=5
RATE_LIMIT_USER_CREATE=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PASSWORD_VERIFY=10

# --- Short codes and links ---
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_LENGTH=32
SHORT_CODE_MAX_ATTEMPTS=10
LINK_DEFAULT_EXPIRATION_DAYS=0
LINK_MAX_EXPIRATION_DAYS=3650
GUEST_LINK_RETENTION_DAYS=30

# --- Advertising and plans ---
ADS_ENABLED=true
ADS_INTERSTITIAL_ENABLED=true
ADS_PROVIDER=none
ADS_SCRIPT_URL=
ADS_CONTINUE_DELAY_SECONDS=0
PLAN_FREE_MAX_LINKS=100
PLAN_PAID_MAX_LINKS=-1

# --- Analytics ---
ANALYTICS_UNIQUE_CLICK_WINDOW=24h
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_GEO_GRANULARITY=country

# --- API documentation (keep disabled on public production) ---
OPENAPI_ENABLED=false
SWAGGER_UI_ENABLED=false
